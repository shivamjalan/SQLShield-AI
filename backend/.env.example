# Used when running the backend natively (npm run dev / npm start), talking
# to a Postgres + Redis you're running yourself on localhost.
#
# Using `docker compose up` from the repo root instead? See the root-level
# .env.example instead -- docker-compose.yml builds these connection
# strings itself from just a username/password.
#
# Copy this file to `.env` in this directory and fill in real values.
# `.env` is gitignored.

PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sqlshield_core
# The "protected" business DB the optimizer runs EXPLAIN ANALYZE against.
# Created and seeded by `npm run db:seed-target`.
TARGET_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/target_db
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace_with_a_long_random_secret

# OpenAI-compatible LLM used only for risk explanations/suggested rewrites --
# never for the allow/block decision itself. Defaults target NaraRouter
# (router.bynara.id) -- swap both values to point at a different
# OpenAI-compatible provider.
LLM_API_KEY=replace_with_your_llm_api_key
LLM_BASE_URL=https://router.bynara.id/v1
LLM_MODEL=agnes-2.0-flash
