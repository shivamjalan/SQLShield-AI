# Used by `docker compose up` -- these fill in ${VAR} references in
# docker-compose.yml (Postgres/Redis run as containers, so this file only
# needs credentials, not full connection strings/hostnames).
#
# Running the backend natively instead (npm run dev, no Docker)? See
# backend/.env.example instead -- that one has full localhost connection
# strings.
#
# Copy this file to `.env` in the repo root (same directory as
# docker-compose.yml) and fill in real values. `.env` is gitignored.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_postgres_password
POSTGRES_DB=sqlshield_core

JWT_SECRET=replace_with_a_long_random_secret

# OpenAI-compatible LLM used only for risk explanations/suggested rewrites --
# never for the allow/block decision itself. Defaults target NaraRouter
# (router.bynara.id) -- swap both values to point at a different
# OpenAI-compatible provider.
LLM_API_KEY=replace_with_your_llm_api_key
LLM_BASE_URL=https://router.bynara.id/v1
LLM_MODEL=agnes-2.0-flash
